<div class="container-fluid" id="top-container">
    <h1 class="text-center" id="main-title">Encontre o emprego dos seus sonhos</h1>
    <p class="text-center" id="main-subtitle">Somos o site com mais vagas de tecnologias no mercado, direcionadas a
        home office</p>
    <form action="/" method="GET" id="search-form" class="input-group">
        <div class="form-group col-md-10">
            <input type="text" class="form-control" id="job" name="job" placeholder="Digite a vaga que está buscando">
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary">Procurar</button>
        </div>
    </form>
</div>

<main>
    <div class="container" id="jobs-container">
        <div class="row">
            <div class="col-md-12">
                {{#if search}}
                <h2 id="job-list-title">Buscando vagas que contem: {{search}}</h2>
                {{else}}
                <h2 id="job-list-title">Veja as nossas vagas em destaque!</h2>
                {{/if}}
                <ul class="list-group" id="job-list">
                    {{#each jobs}}
                    <li class="list-group-item {{#if dataValues.new_job }}new-job{{/if}}">
                        <img src="/img/company.svg" alt="Company">
                        <p>{{dataValues.company}}</p>
                        <h2>{{dataValues.title}}</h2>
                        <p>R${{dataValues.salary}}</p>
                        <span class="new-job-label">Nova</span>
                        <a href="/jobs/view/{{dataValues.id}}" class="btn btn-primary">Ver vaga</a>
                    </li>
                    {{/each}}
                </ul>
            </div>
        </div>
    </div>
</main>